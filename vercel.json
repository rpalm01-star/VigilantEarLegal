{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "https://apps.apple.com/app/id6761978703",
      "permanent": false
    },
    {
      "source": "/app/",
      "destination": "https://apps.apple.com/app/id6761978703",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/docs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
